# ============================================================
# PathPilot AI — Environment Variable Configuration Template
# ============================================================
# Copy this file to '.env' for local development:
#   cp .env.example .env
# Never commit actual API keys or secrets to version control.

# Server Environment & Port Configuration
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Google Gemini API Key (Server-side)
# Obtain your key from: https://aistudio.google.com/
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Supabase Infrastructure Configuration
# Obtain credentials from: https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY_HERE
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY_HERE
SUPABASE_JWT_SECRET=YOUR_SUPABASE_JWT_SECRET_HERE
